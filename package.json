{
  "name": "lunaris",
  "version": "0.1.0",
  "private": true,
  "description": "A Nintendo DS emulator - Rust-based",
  "homepage": "https://github.com/Thoughts-with-friends/lunaris",
  "license": "GPL-3.0",
  "scripts": {
    "fmt": "cargo fmt --all",
    "lint": "cargo clippy --workspace --fix --allow-staged --allow-dirty",
    "build:imgui": "cargo build --release --features release --package lunaris",
    "build:egui": "cargo build --release --features release --package lunaris-egui",
    "imgui": "cargo run --release --features release --package lunaris",
    "egui": "cargo run --release --features release --package lunaris-egui",
    "build:icons": "tauri icon ./gui/tauri/src-tauri/icons/icon.svg",
    "test:back": "cargo nextest run --workspace",
    "test:front": "npm --workspace gui/tauri run test"
  },
  "workspaces": [
    "gui/tauri"
  ],
  "overrides": {
    "monaco-editor": "0.49.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "packageManager": "npm@11.5.2"
}