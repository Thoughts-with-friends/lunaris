{
  "name": "lunaris",
  "version": "0.3.2",
  "private": true,
  "description": "A Nintendo DS emulator - Rust-based",
  "homepage": "https://github.com/Thoughts-with-friends/lunaris",
  "license": "GPL-3.0",
  "scripts": {
    "fmt": "cargo +nightly fmt --all",
    "lint": "cargo clippy --workspace -- -D warnings",
    "lint:fix": "cargo clippy --workspace --fix --allow-staged --allow-dirty",
    "build:imgui": "cargo build --release --features release --package lunaris_imgui",
    "build:egui": "cargo build --release --features release --package lunaris",
    "build:melon": "cargo build --release --features release --package melon_egui",
    "imgui": "cargo run --release --features release --package lunaris_imgui",
    "egui": "cargo run --release --features release --package lunaris",
    "egui:gnu": "cargo +stable-x86_64-pc-windows-gnu run --release",
    "melon": "cargo run --release --features release --package melon_egui",
    "test:back": "cargo nextest run --workspace",
    "release:major": "node ./tools/version_up.cjs major && git push --all",
    "release:minor": "node ./tools/version_up.cjs minor && git push --all",
    "release:patch": "node ./tools/version_up.cjs patch && git push --all"
  },
  "overrides": {
    "monaco-editor": "0.49.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "packageManager": "npm@11.5.2"
}
